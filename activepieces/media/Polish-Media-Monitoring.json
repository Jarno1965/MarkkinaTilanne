{
  "name": "Polish Media Monitoring",
  "description": "Monitoroi puolalaisia uutissivustoja ja luo yhteenvetoraportteja",
  "version": "1.0.0",
  "trigger": {
    "type": "cron",
    "cronExpression": "0 0 9 * * 1-5",
    "timezone": "Europe/Helsinki"
  },
  "tasks": [
    {
      "id": "collect_polish_sources",
      "type": "http_request",
      "settings": {
        "method": "GET",
        "url": "https://api.allorigins.win/get?url=https://www.tvp.info/",
        "responseType": "json"
      }
    },
    {
      "id": "scrape_major_sites",
      "type": "parallel",
      "settings": {
        "tasks": [
          {
            "id": "scrape_tvp_info",
            "type": "http_request",
            "settings": {
              "method": "GET",
              "url": "https://api.allorigins.win/get?url=https://www.tvp.info/",
              "responseType": "json"
            }
          },
          {
            "id": "scrape_polsat_news",
            "type": "http_request",
            "settings": {
              "method": "GET",
              "url": "https://api.allorigins.win/get?url=https://www.polsatnews.pl/",
              "responseType": "json"
            }
          },
          {
            "id": "scrape_wprost",
            "type": "http_request",
            "settings": {
              "method": "GET",
              "url": "https://api.allorigins.win/get?url=https://www.wprost.pl/",
              "responseType": "json"
            }
          }
        ]
      }
    },
    {
      "id": "extract_headlines",
      "type": "javascript",
      "settings": {
        "code": "const articles = [];\n// Yhdistä kaikki lähteet\nconst sources = [inputs.scrape_tvp_info, inputs.scrape_polsat_news, inputs.scrape_wprost];\nsources.forEach(source => {\n  if (source && source.contents) {\n    // Yksinkertainen HTML-parserointi\n    const titles = source.contents.match(/<h[1-3][^>]*>([^<]+)<\\/h[1-3]>/gi) || [];\n    titles.forEach(title => {\n      const cleanTitle = title.replace(/<[^>]*>/g, '').trim();\n      if (cleanTitle.length > 20) {\n        articles.push(cleanTitle);\n      }\n    });\n  }\n});\nreturn { articles: articles.slice(0, 50) };"
      }
    },
    {
      "id": "analyze_sentiment_and_topics",
      "type": "llm_completion",
      "settings": {
        "provider": "openai",
        "model": "gpt-4",
        "prompt": "Analysoi seuraavat puolankieliset otsikot ja tee tiivistelmä suomeksi. Korosta erityisesti:\n1. Politiikka ja hallinto (hallitus, presidentti, parlamentti)\n2. Talous ja työelämä (inflaatio, työttömyys, yritykset)\n3. Turvallisuus ja oikeus (rikollisuus, oikeusjärjestelmä, rajat)\n4. Ympäristö ja energia (ilmasto, energiakriisi, maatalous)\n5. Arkielämä ja yhteiskunta (koulutus, terveys, kulttuuri)\n\nOtsikot:\n{{extract_headlines.articles}}",
        "temperature": 0.7,
        "maxTokens": 2000
      }
    },
    {
      "id": "format_weekly_report",
      "type": "template",
      "settings": {
        "template": "<!DOCTYPE html><html lang='fi'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Puolan viikkokatsaus {{date}}</title><style>body{font-family:sans-serif;line-height:1.6;margin:2rem;max-width:800px}h1,h2{color:#1a5fb4}article{margin:2rem 0;padding:1rem;border-left:4px solid #1a5fb4;background:#f8f9fa}time{color:#666;font-size:0.9rem}</style></head><body><header><h1>Puolan viikkokatsaus</h1><time datetime='{{date}}'>{{formatted_date}}</time></header><main>{{analyze_sentiment_and_topics.response}}</main><footer><p>Raportti luotu automaattisesti puolalaisten medioiden analyysistä.</p></footer></body></html>",
        "variables": {
          "date": "{{current_date}}",
          "formatted_date": "{{current_date_finnish}}"
        }
      }
    },
    {
      "id": "save_local_copy",
      "type": "file_write",
      "settings": {
        "path": "data/media/polish-weekly-{{current_date}}.html",
        "content": "{{format_weekly_report.output}}",
        "encoding": "utf8"
      }
    },
    {
      "id": "commit_to_github",
      "type": "github_commit_file",
      "settings": {
        "owner": "Jarno1965",
        "repo": "MarkkinaTilanne",
        "filePath": "data/media/polish-weekly-{{current_date}}.html",
        "fileContent": "{{format_weekly_report.output}}",
        "commitMessage": "Lisää Puolan viikkokatsaus {{current_date}}",
        "branch": "main"
      }
    }
  ]
}